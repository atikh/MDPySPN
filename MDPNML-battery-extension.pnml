<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="heatSeal_multi" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <page id="page0">

      <!-- Declared dimensions -->
      <dimensions>
        <dimension name="time" initialValue="0.0"/>
        <dimension name="Battery" initialValue="0.0">
          <subdimension name="BatteryH" initialValue="100.0"/>
          <subdimension name="BatteryL" initialValue="100.0"/>
        </dimension>
        <dimension name="Electricity" initialValue="0.0"/>
      </dimensions>

      <!-- Places -->
      <place id="pI1" dimensionTracked="BatteryL" DoT="1">
        <name><text>AGVLow_idle</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="pA1">
        <name><text>AGVLow_Ready_AGV1 Transport</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="pI2" dimensionTracked="Electricity" DoT="1">
        <name><text>CELL 1_idle</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="pA2">
        <name><text>CELL 1_Ready_Cell 1 Operation</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p2">
        <name><text>direct_to_line1_AGV1 Transport</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="pA3">
        <name><text>AGVHigh_Ready_AGV2 Transport</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="pI3" dimensionTracked="BatteryH" DoT="1">
        <name><text>AGVHigh_idle</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p4">
        <name><text>Cell 1 Operation_End</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p6">
        <name><text>direct_to_line2_AGV2 Transport</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p8">
        <name><text>new_order_XOR</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p9">
        <name><text>AGV1 Transport,AGV2 Transport-FALSE-AND-join</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p10">
        <name><text>AGVHigh_AGV2_Charging</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>
      <place id="p11">
        <name><text>AGVLow_AGV1_Charging</text></name>
        <initialMarking><text>0</text></initialMarking>
      </place>

      <!-- Transitions -->
      <transition id="t1" type="T" input_transition="True">
        <name><text>new_order</text></name>
        <distribution>
          <type>expon</type>
          <parameters>
            <a>0.003</a>
            <b>4.980220437956205</b>
          </parameters>
        </distribution>
      </transition>
      <transition id="t2" type="I">
        <name><text>direct_to_line1</text></name>
        <weight>0.52068345323741</weight>
      </transition>
      <transition id="t3" type="T">
        <name><text>AGV1 Transport</text></name>
        <distribution>
          <type>triang</type>
          <parameters>
            <a>0.527182495419062</a>
            <b>3.984011597705773</b>
            <c>2.027726651118973</c>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryL" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.2500000249086328</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t4" type="T">
        <name><text>Cell 1 Operation</text></name>
        <distribution>
          <type>triang</type>
          <parameters>
            <a>0.508360895023718</a>
            <b>4.987864617714628</b>
            <c>1.992931115567134</c>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Electricity" direction="increase">
            <impactType>rate</impactType>
            <impactValue>1.9999999999999998</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t5" type="I" output_transition="True">
        <name><text>End</text></name>
      </transition>
      <transition id="t6" type="I">
        <name><text>direct_to_line2</text></name>
        <weight>0.47931654676258995</weight>
      </transition>
      <transition id="t7" type="T">
        <name><text>AGV2 Transport</text></name>
        <distribution>
          <type>triang</type>
          <parameters>
            <a>0.49762296879</a>
            <b>2.989744828927889</b>
            <c>2.016095780601365</c>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryH" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.5000000558554606</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t8" type="I">
        <name><text>AGVLow_ready</text></name>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryL" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000303766353</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t9" type="I">
        <name><text>CELL 1_ready</text></name>
        <impactedDimensions>
          <impactedDimension name="Electricity" direction="increase">
            <impactType>rate</impactType>
            <impactValue>0.19999999999527063</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t10" type="I">
        <name><text>AGVHigh_ready</text></name>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryH" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000000014552</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t11" type="I" asset_level="True">
        <name><text>AGVHigh_Idle_to_AGV2_Charging</text></name>
        <weight>1.0</weight>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryH" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000000014552</impactValue>
          </impactedDimension>
        </impactedDimensions>
        <conditions>
          <condition dimension="Battery" source="BatteryH" operator="&lt;=" type="threshold" value="30.0">BatteryH &lt;= 30.0</condition>
        </conditions>
      </transition>
      <transition id="t12" type="T" asset_level="True">
        <name><text>AGVHigh_AGV2_Charging_to_Idle</text></name>
        <distribution>
          <type>charge</type>
          <parameters>
            <a>100.0</a>
            <b>30.0</b>
            <c>1.5</c>
            <battery_dim>BatteryH</battery_dim>
            <max_charging>100.0</max_charging>
            <min_charging>30.0</min_charging>
            <r>1.5</r>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryH" direction="increase">
            <impactType>charge</impactType>
            <impactValue>1.5</impactValue>
            <chargeMax>100.0</chargeMax>
            <chargeMin>30.0</chargeMin>
          </impactedDimension>
          <impactedDimension name="Electricity" direction="increase">
            <impactType>rate</impactType>
            <impactValue>10.0</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t13" type="I" asset_level="True">
        <name><text>AGVLow_Idle_to_AGV1_Charging</text></name>
        <weight>1.0</weight>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryL" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000303766353</impactValue>
          </impactedDimension>
        </impactedDimensions>
        <conditions>
          <condition dimension="Battery" source="BatteryL" operator="&lt;=" type="threshold" value="30.0">BatteryL &lt;= 30.0</condition>
        </conditions>
      </transition>
      <transition id="t14" type="T" asset_level="True">
        <name><text>AGVLow_AGV1_Charging_to_Idle</text></name>
        <distribution>
          <type>charge</type>
          <parameters>
            <a>100.0</a>
            <b>30.0</b>
            <c>1.5</c>
            <battery_dim>BatteryL</battery_dim>
            <max_charging>100.0</max_charging>
            <min_charging>30.0</min_charging>
            <r>1.5</r>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryL" direction="increase">
            <impactType>charge</impactType>
            <impactValue>1.5</impactValue>
            <chargeMax>100.0</chargeMax>
            <chargeMin>30.0</chargeMin>
          </impactedDimension>
          <impactedDimension name="Electricity" direction="increase">
            <impactType>rate</impactType>
            <impactValue>10.0</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t15" type="T" asset_level="True">
        <name><text>BatteryH_status_update</text></name>
        <distribution>
          <type>det</type>
          <parameters>
            <a>1.0</a>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryH" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000000014552</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>
      <transition id="t16" type="T" asset_level="True">
        <name><text>BatteryL_status_update</text></name>
        <distribution>
          <type>det</type>
          <parameters>
            <a>1.0</a>
          </parameters>
        </distribution>
        <impactedDimensions>
          <impactedDimension name="Battery" source="BatteryL" direction="decrease">
            <impactType>rate</impactType>
            <impactValue>0.09000000303766353</impactValue>
          </impactedDimension>
        </impactedDimensions>
      </transition>

